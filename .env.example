# Application settings use the WGA_ prefix.
WGA_APP_NAME=Windows GUI Agent
WGA_LOG_LEVEL=INFO
WGA_LOG_DIR=logs

# LLM Gateway (OpenAI-compatible).
WGA_LLM_PROVIDER=openai_compatible
WGA_LLM_MODEL=qwen3.7-plus
WGA_LLM_BASE_URL=http://127.0.0.1:8000/v1
WGA_LLM_AUTH_MODE=none
# WGA_LLM_API_KEY=replace-with-your-key
# Legacy fallback still supported:
# DASHSCOPE_API_KEY=replace-with-your-key
